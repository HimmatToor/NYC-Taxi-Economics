# Copy this file to .env and fill in real values. .env is gitignored.

# Warehouse Postgres (the actual analytics database)
WAREHOUSE_DB_HOST=localhost
WAREHOUSE_DB_PORT=5432
WAREHOUSE_DB_NAME=taxi_warehouse
WAREHOUSE_DB_USER=taxi_admin
WAREHOUSE_DB_PASSWORD=change_me

# Airflow metadata Postgres (separate instance/db, do not reuse the warehouse db)
AIRFLOW_DB_HOST=localhost
AIRFLOW_DB_PORT=5433
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me

AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
